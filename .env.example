# Copy to .env and fill in. Never commit .env.
# Generate SECRET_KEY and OUTBOX_ENCRYPTION_KEYS with:
#   docker compose run --rm --no-deps tools serpsense gen-secrets >> .env

# Core
APP_ENV=development                  # development | production
BASE_URL=http://localhost:8000
SECRET_KEY=                          # >= 32 chars; OTP HMAC + CSRF
OUTBOX_ENCRYPTION_KEYS=              # comma-separated Fernet keys (first encrypts; all decrypt)
SERPSENSE_MODE=live                  # live | replay: recorded scans and labels, no API keys needed
#                                      (refused in production)
# DATABASE_URL and REDIS_URL are set by docker-compose.yml for local development.

# SerpApi
SERPAPI_API_KEY=
MAX_SEARCHES_PER_SCAN=40
SERPAPI_DAILY_GLOBAL_CAP=500
DEFAULT_MONTHLY_SEARCH_BUDGET=1500

# Claude
ANTHROPIC_API_KEY=
ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5
DEFAULT_LLM_PRESET=balanced          # fast | balanced | high_thinking | maximum
DEFAULT_MONTHLY_LLM_BUDGET_MICROS=30000000
LLM_REFUSAL_FALLBACK=true

# Auth
SESSION_DAYS=7
OTP_TTL_MINUTES=10
SIGNUP_MODE=open                     # open | invite (invite required in production)
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Email (Mailpit locally: inbox at http://localhost:8025)
EMAIL_BACKEND=smtp                   # smtp | console (console refused in production)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=SerpSense <no-reply@serpsense.local>

# Operator console at /admin (ADR-0014): off unless set; at least 16 characters, e.g.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
ADMIN_PASSWORD=

# Observability
LOG_LEVEL=INFO
