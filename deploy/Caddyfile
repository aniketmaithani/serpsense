# TLS termination for docker-compose.prod.yml. Caddy obtains and renews the Let's Encrypt
# certificates itself once DNS for {$DOMAIN} and www.{$DOMAIN} points at this host.
# No access log: the app logs route templates only, never raw paths or client addresses.

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header -Server
	reverse_proxy web:8000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
